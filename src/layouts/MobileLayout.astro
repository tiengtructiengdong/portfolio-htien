---
/**
 * MobileLayout.astro
 * Single-column flex layout for mobile.
 * Hidden above 1280px (mirrored in DesktopLayout).
 */
import clsx from "clsx";
import BaseLayout from "./BaseLayout.astro";
import { MOBILE_SHELL } from "@lib/classes";

export interface Props {
  title?: string;
  description?: string;
  lang?: import("./BaseLayout.astro").Props["lang"];
}

const { title, description, lang } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class={MOBILE_SHELL}>
    <slot name="header" />
    <main>
      <slot />
    </main>
  </div>
</BaseLayout>